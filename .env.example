# Tactus configuration (spec S-1). Copy to .env (loaded automatically at startup)
# or set real environment variables. Real environment variables win over .env.

# HTTP port. Default 3200.
PORT=3200

# Bind address. Default 127.0.0.1. A non-loopback HOST without AUTH_TOKEN logs a warning.
HOST=127.0.0.1

# Directory for runtime data. Default <repo>/data.
# DATA_DIR=./data

# SQLite database file. Default $DATA_DIR/tactus.db.
# DB_PATH=./data/tactus.db

# Shared access token. Unset = auth off. Set = every /api/* route except /api/health and /api/auth/* requires it.
# Must be at least 24 characters or the server refuses to start. Generate one with: openssl rand -hex 24
# AUTH_TOKEN=change-me

# Set to 1 when running behind a reverse proxy (e.g. Heroku) so secure cookies work.
# TRUST_PROXY=1
